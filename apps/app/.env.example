# Fuente de datos de la demo: 'local' (navegador) o 'supabase' (Postgres en la nube).
NEXT_PUBLIC_TABI_FUENTE=local

# Mientras Tabi atienda un restaurante por despliegue, este slug dice cuál.
NEXT_PUBLIC_TABI_RESTAURANTE=la-cocina-de-ana

# La llave anon es pública por diseño; lo que protege los datos son las políticas RLS.
# La llave service_role NUNCA va en una variable NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-LLAVE-ANON
